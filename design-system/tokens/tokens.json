{
  "$description": "Souvenote Design System tokens: berry & ivory v1.0 (2026-11-01). W3C Design Tokens (DTCG) format. Mirrors tokens.css; source of truth is frontend/app/styles/landing.css.",
  "color": {
    "$type": "color",
    "berry": {
      "400": { "$value": "#AC4A66", "$description": "Light end of the berry card gradient" },
      "500": { "$value": "#9E3D58", "$description": "Dusty berry: brand, script accents, labels, hover" }
    },
    "ivory": {
      "50": { "$value": "#FFFDF8", "$description": "Light end of the paper card gradient" },
      "100": { "$value": "#FFFAF3", "$description": "Paper: tiles, table" },
      "200": { "$value": "#F7F0E8", "$description": "Warm ivory: page background" },
      "300": { "$value": "#EFE3D5", "$description": "Raised ivory: open FAQ, popovers" },
      "400": { "$value": "#D9CFC3", "$description": "Oat: secondary text on forest" }
    },
    "espresso": {
      "500": { "$value": "#655250", "$description": "Cocoa: secondary text" },
      "700": { "$value": "#4A3B39", "$description": "Soft espresso: primary text, headings" }
    },
    "forest": {
      "500": { "$value": "#3A4C48", "$description": "Light end of the forest card gradient" },
      "600": { "$value": "#3B4D49", "$description": "Primary button hover" },
      "700": { "$value": "#2F3E3B", "$description": "Forest green: primary actions, nav, footer, comparison band" }
    },
    "gold": {
      "300": { "$value": "#E2C478", "$description": "Light end of the gold card gradient" },
      "400": { "$value": "#D8B65A", "$description": "Antique gold: AI accent, logo tint" }
    },
    "platinum": {
      "400": { "$value": "#CBCFD6", "$description": "Platinum: the music note in the S mark only (same as the app's --platinum-mid)" }
    },
    "terracotta": {
      "300": { "$value": "#D49A88", "$description": "Light end of the terracotta card gradient" },
      "400": { "$value": "#C98A76", "$description": "Muted terracotta: top stripes, glow. Never text." }
    },
    "white": { "$value": "#FFFFFF" }
  },
  "role": {
    "$type": "color",
    "bg": { "$value": "{color.ivory.200}", "$extensions": { "landing": "--l-bg" } },
    "surface-raised": { "$value": "{color.ivory.300}", "$extensions": { "landing": "--l-raised" } },
    "surface-paper": { "$value": "{color.ivory.100}", "$extensions": { "landing": "--l-paper" } },
    "surface-ai": { "$value": "{color.gold.400}", "$extensions": { "landing": "--l-ai" } },
    "surface-inverse": { "$value": "{color.forest.700}", "$extensions": { "landing": "--l-dark-bg" } },
    "text": { "$value": "{color.espresso.700}", "$extensions": { "landing": "--l-text" } },
    "text-muted": { "$value": "{color.espresso.500}", "$extensions": { "landing": "--l-text-2" } },
    "text-script": { "$value": "{color.berry.500}", "$extensions": { "landing": "--l-script-color" } },
    "text-label": { "$value": "{color.berry.500}", "$extensions": { "landing": "--l-label" } },
    "text-on-ai": { "$value": "{color.espresso.700}", "$extensions": { "landing": "--l-ai-ink" } },
    "hover": { "$value": "{color.berry.500}", "$extensions": { "landing": "--l-hover" } },
    "focus": { "$value": "{color.forest.700}", "$extensions": { "landing": "--l-focus" } },
    "action-bg": { "$value": "{color.forest.700}", "$extensions": { "landing": "--l-btn-bg" } },
    "action-bg-hover": { "$value": "{color.forest.600}", "$extensions": { "landing": "--l-btn-bg-hover" } },
    "action-ink": { "$value": "{color.ivory.200}", "$extensions": { "landing": "--l-btn-ink" } },
    "yes": { "$value": "{color.forest.700}", "$extensions": { "landing": "--l-yes" } },
    "no": { "$value": "{color.espresso.500}", "$extensions": { "landing": "--l-no" } },
    "stripe": { "$value": "{color.terracotta.400}", "$extensions": { "landing": "--l-stripe" } },
    "stripe-ai": { "$value": "{color.berry.500}", "$extensions": { "landing": "--l-stripe-2" } },
    "logo-tint": { "$value": "{color.gold.400}", "$description": "Colour of the pre-tinted logo files; not applied in CSS", "$extensions": { "landing": "/assets/wordmark-gold.png, /assets/logomark-gold-silver.png" } },
    "engrave": { "$value": "{color.espresso.700}", "$extensions": { "landing": "--l-engrave-color", "opacity": 0.55 } },
    "line": { "$value": "rgba(74, 59, 57, 0.14)", "$extensions": { "landing": "--l-line" } },
    "line-strong": { "$value": "rgba(74, 59, 57, 0.34)", "$extensions": { "landing": "--l-line-strong" } },
    "line-paper": { "$value": "rgba(74, 59, 57, 0.16)", "$extensions": { "landing": "--l-paper-line" } }
  },
  "role-forest": {
    "$description": "Overrides on forest-green surfaces (nav, footer, comparison band).",
    "$type": "color",
    "text": { "$value": "{color.ivory.200}", "$extensions": { "landing": "--l-dark-ink" } },
    "text-muted": { "$value": "{color.ivory.400}", "$extensions": { "landing": "--l-dark-ink-2" } },
    "hover": { "$value": "{color.gold.400}", "$extensions": { "landing": "--l-dark-accent" } },
    "text-label": { "$value": "{color.gold.400}" },
    "focus": { "$value": "{color.gold.400}" },
    "action-bg": { "$value": "{color.ivory.200}", "$extensions": { "landing": "--l-dark-btn-bg" } },
    "action-bg-hover": { "$value": "{color.white}", "$extensions": { "landing": "--l-dark-btn-bg-hover" } },
    "action-ink": { "$value": "{color.forest.700}", "$extensions": { "landing": "--l-dark-btn-ink" } },
    "line": { "$value": "rgba(247, 240, 232, 0.16)" },
    "line-strong": { "$value": "rgba(247, 240, 232, 0.4)" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Lato", "ui-sans-serif", "system-ui", "sans-serif"] },
      "script": { "$value": ["Lobster Two", "cursive"] }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 300, "fontSize": "clamp(2.9rem, 1.6rem + 6.2vw, 5.2rem)", "lineHeight": 1.05, "letterSpacing": "-0.02em" } },
    "h2": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 300, "fontSize": "clamp(2.1rem, 1.5rem + 2.8vw, 3.5rem)", "lineHeight": 1.15, "letterSpacing": "-0.01em" } },
    "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "clamp(1.45rem, 1.3rem + 0.6vw, 1.75rem)", "lineHeight": 1.25, "letterSpacing": "0" } },
    "lede": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "clamp(1.1rem, 1rem + 0.45vw, 1.3rem)", "lineHeight": 1.65, "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.65, "letterSpacing": "0" }, "$description": "18px at >=600px" },
    "button": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "17px", "lineHeight": 1, "letterSpacing": "0.02em" } },
    "nav": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "12px", "lineHeight": 1.2, "letterSpacing": "0.16em" }, "$description": "Uppercase" },
    "label": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 700, "fontSize": "12px", "lineHeight": 1.3, "letterSpacing": "0.18em" }, "$description": "Uppercase" },
    "script": { "$value": { "fontFamily": "{font.family.script}", "fontWeight": 400, "fontSize": "1.1em", "lineHeight": 1.08, "letterSpacing": "0" }, "$description": "Accent words only, sized relative to their line" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "7": { "$value": "28px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "11": { "$value": "44px" }, "12": { "$value": "48px" }, "14": { "$value": "56px" },
    "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }
  },
  "layout": {
    "$type": "dimension",
    "max": { "$value": "1200px" },
    "gutter": { "$value": "20px", "$extensions": { "sm": "32px", "lg": "48px" } },
    "section-space": { "$value": "64px", "$extensions": { "sm": "80px", "lg": "96px" } },
    "tap-target": { "$value": "44px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "xs": { "$value": "480px", "$description": "Hero buttons go side by side" },
    "sm": { "$value": "600px", "$description": "Larger gutters, 18px body" },
    "nav": { "$value": "701px", "$description": "Nav links appear" },
    "md": { "$value": "900px", "$description": "Steps go three across" },
    "hero": { "$value": "960px", "$description": "Two-column hero" },
    "lg": { "$value": "1024px", "$description": "Gallery side rail, 96px sections" },
    "xl": { "$value": "1221px", "$description": "Tall nav" },
    "xxl": { "$value": "1296px", "$description": "Side engravings beside the hero card and FAQ" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "10px" }, "md": { "$value": "16px" }, "lg": { "$value": "18px" },
    "xl": { "$value": "22px" }, "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": { "offsetX": "0", "offsetY": "8px", "blur": "20px", "spread": "0", "color": "rgba(74, 59, 57, 0.16)" } },
    "2": { "$value": { "offsetX": "0", "offsetY": "12px", "blur": "26px", "spread": "0", "color": "rgba(74, 59, 57, 0.16)" } },
    "3": { "$value": [
      { "offsetX": "0", "offsetY": "18px", "blur": "40px", "spread": "0", "color": "rgba(74, 59, 57, 0.14)" },
      { "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0", "color": "rgba(74, 59, 57, 0.08)" }
    ] }
  },
  "motion": {
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.22, 1, 0.36, 1] } },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "200ms" }, "base": { "$value": "250ms" }, "medium": { "$value": "350ms" },
      "flip": { "$value": "700ms" }, "vinyl": { "$value": "3200ms" }, "spin": { "$value": "30000ms" }
    }
  }
}
